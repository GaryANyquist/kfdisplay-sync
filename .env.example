# Copy to .env and fill in. Never commit the real file.

# --- the key the tablet must send (npm run make-key prints one) -------------
# Type the same key into the tablet: Settings -> KFDisplay sync -> Sync key.
SYNC_KEY=

# Port the tablet connects to. Allow it through Windows Firewall (see README).
SYNC_PORT=8787

# --- KFDisplay database ------------------------------------------------------
KFDISPLAY_SERVER=localhost
KFDISPLAY_DATABASE=KFDisplay
# Pick ONE: INSTANCE (SQL Browser resolves the port) or PORT (pinned static port).
KFDISPLAY_INSTANCE=SQLEXPRESS
#KFDISPLAY_PORT=1433

# The write login from setup/03-create-sync-login.sql. Not the read-only one.
KFDISPLAY_USER=register_sync
KFDISPLAY_PASSWORD=

KFDISPLAY_ENCRYPT=false
KFDISPLAY_TRUST_SERVER_CERT=true
# SQL Server 2012/2014: needed for the TLS login handshake from Node 18+.
KFDISPLAY_LEGACY_TLS=true
